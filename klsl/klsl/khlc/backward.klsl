// backward.klsl — xshard fold backward pass (xshard-backward grad format)
// Reads fwd_hidden from SHM binding, computes weight gradients, clips by L2 norm
// Compile: klslc backward.klsl

⟁ shader fold_backward

  ⟁Wo⟁ stage "compute"
  ⟁Wo⟁ threads [32, 1, 1]

  ⟁Wo⟁ StructuredBuffer<float>    grad_out   : register(t0)
  ⟁Wo⟁ StructuredBuffer<float>    fwd_hidden : register(t1)
  ⟁Wo⟁ StructuredBuffer<float>    weights    : register(t2)
  ⟁Wo⟁ RWStructuredBuffer<float>  grad_w     : register(u0)
  ⟁Wo⟁ ConstantBuffer<BwdConst>   cb         : register(b0)

  // BwdConst: uint seq_len, n_embd, n_shard; float grad_clip, grad_scale

  [Pop fold_backward]
    ⟁Wo⟁ uint tid = SV_DispatchThreadID.x
    ⟁Sek⟁ if (tid >= cb.n_shard) return

    // d_hidden = grad_out @ weights[tid] (reverse lm_head)
    ⟁Wo⟁ float d_h = 0.0f
    ⟁K'ayab'⟁ uint s in 0 .. cb.seq_len
      ⟁Sek⟁ d_h += grad_out[s] * weights[s * cb.n_shard + tid]
    ⟁Kumk'u⟁

    // SwiGLU gradient: silu_grad * gate_grad
    ⟁Wo⟁ float h   = fwd_hidden[tid]
    ⟁Wo⟁ float sig = 1.0f / (1.0f + exp(-h))
    ⟁Wo⟁ float silu_grad = sig * (1.0f + h * (1.0f - sig))
    ⟁Wo⟁ float d_w = d_h * silu_grad * cb.grad_scale

    // L2-norm gradient clip (applied per-shard element; full norm needs reduction)
    ⟁Wo⟁ float g_norm = abs(d_w)
    ⟁Wo⟁ float clip   = (g_norm > cb.grad_clip) ? (cb.grad_clip / g_norm) : 1.0f
    ⟁Sek⟁ grad_w[tid] = d_w * clip
  [Xul]

⟁Xul⟁
